# ==============================================================================
# Expense Tracker Environment Variables
# ==============================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_user
MYSQL_PASSWORD=expense_pass
MYSQL_PORT=3306

# Spring Boot Backend Configuration
DB_URL=jdbc:mysql://localhost:3306/expense_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=expense_user
DB_PASSWORD=expense_pass
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
